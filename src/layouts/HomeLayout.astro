---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import { personJsonLd, websiteJsonLd } from '../lib/seo';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <SeoHead jsonLd={[personJsonLd, websiteJsonLd]} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0E0A08" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script
      is:inline
      id="counterscale-script"
      data-site-id="mikecousins"
      src="https://counterscale.cousins.ai/tracker.js"
      defer></script>
  </head>
  <body class="bg-ink-950 text-ink-100 font-sans antialiased overflow-hidden">
    <slot />
    <script>
      // Curious visitors: hello.
      const banner = [
        '',
        '  m i k e .',
        '  c o u s i n s .',
        '',
        '  architect / developer / fractional CTO',
        '  calgary  ·  51.0°N',
        '',
        '  mike@cousins.ai  ·  cal.com/mikecousins',
        '',
      ].join('\n');
      // oxlint-disable-next-line no-console
      console.log(
        '%c' + banner,
        'color: oklch(0.72 0.21 50); font-family: ui-monospace, monospace; font-size: 12px; line-height: 1.4;'
      );
    </script>
  </body>
</html>
